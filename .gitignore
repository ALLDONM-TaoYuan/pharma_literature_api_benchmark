# Benchmark results: very large (the full literature text returned by each interface),
# not committed; regenerate them when needed
**/output/
**/ALL_result/
**/_digest/

# Dry-run artifacts of the variant modules (query plans, live results); regenerated by one run
**/tests/dry_run/
**/tests/live/

# Reports and workbooks: for local use only, not committed
# (reports are generated by gen_reports.py and land under output/; workbooks are local input)
*.md
*.xlsx
# the project README at the root is committed
!/README.md

# Local environment variables (keys and internal addresses); copy .env.example and keep real values out
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Run logs
*.log

# Editors
.vscode/
.idea/
.DS_Store
Thumbs.db
