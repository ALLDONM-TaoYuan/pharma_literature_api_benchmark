# Benchmark results: very large (the full literature text returned by each interface),
# not committed; regenerate them when needed
**/output/
**/ALL_result/
**/_digest/

# Dry-run artifacts of the variant modules (query plans, live results); regenerated by one run
**/tests/dry_run/
**/tests/live/

# Generated reports: local only, not committed
# (reports are generated by gen_reports.py and land under output/)
*.md
# the project README at the root is committed
!/README.md

# Input workbooks (*.xlsx) ARE committed on purpose: they hold the object lists
# the collectors read, so a fresh clone can run without extra files.

# Local environment variables (keys and internal addresses); copy .env.example and keep real values out
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Run logs
*.log

# Editors
.vscode/
.idea/
.DS_Store
Thumbs.db
