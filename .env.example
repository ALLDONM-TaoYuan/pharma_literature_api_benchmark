# Copy this file to .env and fill in the real values.
# .env is ignored by .gitignore and will never be committed.

# Tavily search API key. Leave empty to skip the tavily and tavily_guideline interfaces.
TAVILY_API_KEY=

# Connection details of the local literature database (Elasticsearch). All four are required.
ES_URL=
ES_INDEX=
ES_USER=
ES_PASSWORD=

# openFDA API key. Optional; the interface works without it.
OPENFDA_API_KEY=

# Proxy used to reach interfaces outside the intranet. Leave empty for a direct connection.
# HTTPS_PROXY=http://127.0.0.1:7890
